# FastAPI application (development)
# Compose MVP uses compose.env (copy compose.env.example) with compose.yaml.
# Do not feed this file's DATABASE_URL=sqlite://... into Compose interpolation.
# Generate API_JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=
DATABASE_URL=sqlite:///.api/analyzer.db
# Local workspace path retained for host-process compatibility; HDFS datasets use
# object storage through the authenticated upload route.
API_TRUSTED_WORKSPACE_ROOT=workspace
# Local filesystem object root for admitted model packages. Ignored when Bucket
# settings below are all set.
API_OBJECT_STORE_ROOT=.api/objects
API_JWT_TTL_MINUTES=30
# Private on-demand inference service. Set both together, or neither. The public API
# process must not load this token into JWT signing, and the inference process must
# not require API_JWT_SECRET. Never put these in the React build.
# INFERENCE_SERVICE_URL=http://127.0.0.1:8080
# INFERENCE_INTERNAL_TOKEN=
# INFERENCE_CONNECT_TIMEOUT_SECONDS=2
# INFERENCE_READ_TIMEOUT_SECONDS=5
# INFERENCE_RETRY_ATTEMPTS=5
# INFERENCE_RETRY_BACKOFF_SECONDS=2
# INFERENCE_STALE_RUNNING_SECONDS=1800
# Private model-package validator. Set both together, or neither. Register returns
# 503 when neither this pair nor an injected command (tests / scripts/e2e_serve.py)
# is configured. Do not put this token on the React build, and do not give the
# validator process API_JWT_SECRET, DATABASE_URL, or object-store credentials.
# MODEL_VALIDATOR_SERVICE_URL=http://127.0.0.1:8081
# MODEL_VALIDATOR_INTERNAL_TOKEN=
# MODEL_VALIDATOR_CONNECT_TIMEOUT_SECONDS=2
# MODEL_VALIDATOR_READ_TIMEOUT_SECONDS=120
# Pinned F-03 evaluation-data catalog for private inference. Set both together on
# the inference process only; do not put them on the public API, frontend, or
# model-validator. Locally, the value is the ignored workspace artifact
# manifest.json (artifacts/cache/hdfs/evaluation-data/<fingerprint>/manifest.json).
# On Railway staging, the value is the Bucket object key
# hdfs/reference-catalog/manifest.json (sibling selected-block-ids.txt required).
# Calculate the manifest SHA-256 at deploy time; do not commit the digest or the
# generated files. A missing or mismatched catalog fails the analysis run and
# makes inference /health return 503. It does not classify every block as
# provisional. Catalog membership is a heuristic, not proof that an HDFS
# lifecycle ended.
# INFERENCE_HDFS_COMPLETENESS_MANIFEST=
# INFERENCE_HDFS_COMPLETENESS_MANIFEST_SHA256=
# Optional S3-compatible Bucket backend (Railway staging). Set all four together.
# Never put these in the React build. The isolated validator does not receive them.
# API_OBJECT_STORE_ENDPOINT=
# API_OBJECT_STORE_BUCKET=
# API_OBJECT_STORE_ACCESS_KEY_ID=
# API_OBJECT_STORE_SECRET_ACCESS_KEY=
# API_OBJECT_STORE_REGION=auto

# Optional. Postgres-marked tests and local dialect checks.
# Mutually exclusive with root compose.yaml on host 5433.
# docker compose -f tests/postgres/compose.yaml up -d
# When the MVP stack is up, point TEST_DATABASE_URL at it instead:
# TEST_DATABASE_URL=postgresql://analyzer:analyzer@127.0.0.1:5433/analyzer
# TEST_DATABASE_URL=