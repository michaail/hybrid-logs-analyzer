# Azure OpenAI (production)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_MISTRAL_LARGE=Mistral-Large-3
AZURE_OPENAI_DEPLOYMENT_MISTRAL_SMALL=mistral-small-2503
AZURE_OPENAI_API_VERSION=2025-06-01
AZURE_OPENAI_DEPLOYMENT_DEEPSEEK_V4_FLASH=DeepSeek-V4-Flash
AZURE_OPENAI_DEPLOYMENT_DEEPSEEK_V4_PRO=DeepSeek-V4-Pro

# FastAPI application (development)
# Generate API_JWT_SECRET with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=
DATABASE_URL=sqlite:///.api/analyzer.db
# Controlled workspace for stored HDFS log references until dataset intake exists.
API_TRUSTED_WORKSPACE_ROOT=workspace
# Local filesystem object root for admitted model packages. Ignored when Bucket
# settings below are all set.
API_OBJECT_STORE_ROOT=.api/objects
API_JWT_TTL_MINUTES=30
# Private on-demand inference service. Set both together, or neither. The public API
# process must not load this token into JWT signing, and the inference process must
# not require API_JWT_SECRET. Never put these in the React build.
# INFERENCE_SERVICE_URL=http://127.0.0.1:8080
# INFERENCE_INTERNAL_TOKEN=
# INFERENCE_CONNECT_TIMEOUT_SECONDS=2
# INFERENCE_READ_TIMEOUT_SECONDS=5
# INFERENCE_RETRY_ATTEMPTS=5
# INFERENCE_RETRY_BACKOFF_SECONDS=2
# Optional S3-compatible Bucket backend (Railway staging). Set all four together.
# Never put these in the React build. The isolated validator does not receive them.
# API_OBJECT_STORE_ENDPOINT=
# API_OBJECT_STORE_BUCKET=
# API_OBJECT_STORE_ACCESS_KEY_ID=
# API_OBJECT_STORE_SECRET_ACCESS_KEY=
# API_OBJECT_STORE_REGION=auto

# Optional. Postgres-marked tests and local dialect checks.
# docker compose -f tests/postgres/compose.yaml up -d
# TEST_DATABASE_URL=postgresql://analyzer:analyzer@127.0.0.1:5433/analyzer
# TEST_DATABASE_URL=