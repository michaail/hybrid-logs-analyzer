# Copy this file to compose.env and fill in values. Keep compose.env out of Git.
# Always start the stack with:
#   docker compose --env-file compose.env up --build
#
# Do not feed host .env (SQLite DATABASE_URL) into this stack. compose.yaml
# hardcodes the Postgres service URL. compose.env is for interpolation and
# secrets only — it must not set DATABASE_URL.
#
# Generate high-entropy secrets, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use a POSTGRES_PASSWORD without @, :, /, or # so the database URL stays valid.
#
# HDFS_COMPLETENESS_CATALOG_DIR is a host directory the operator must already
# have. It must contain manifest.json and sibling selected-block-ids.txt.
# Leave it empty and compose.yaml binds /tmp/hdfs-completeness-catalog so
# `docker compose config` still decodes; inference /health stays 503 until
# the real tree matches INFERENCE_HDFS_COMPLETENESS_MANIFEST_SHA256
# (64-character hex).
#
# Trusted v3 ZIPs (releases/hdfs/attribute-gae-v3.zip and the matching
# preprocessing ZIP) are required for the recorded Publisher upload. They are
# not part of this env file and must not be committed.
#
# Postgres user and database are analyzer. When this stack is up, dialect tests:
#   TEST_DATABASE_URL=postgresql://analyzer:<POSTGRES_PASSWORD>@127.0.0.1:5433/analyzer
# Do not start tests/postgres/compose.yaml at the same time (both bind 5433).

API_JWT_SECRET=
POSTGRES_PASSWORD=
INFERENCE_INTERNAL_TOKEN=
MODEL_VALIDATOR_INTERNAL_TOKEN=
HDFS_COMPLETENESS_CATALOG_DIR=
INFERENCE_HDFS_COMPLETENESS_MANIFEST_SHA256=
