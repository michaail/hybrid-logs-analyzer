+from typing import Literal
+
+from pydantic import BaseModel, Field
+
+
+EvidenceLevel = Literal[
+    "explicit_template",
+    "retrieved_documentation",
+    "corpus_observation",
+    "unknown",
+]
+
+DiagnosticRole = Literal[
+    "informational",
+    "lifecycle_transition",
+    "warning_or_error",
+    "context_dependent",
+    "unknown",
+]
+
+RelationType = Literal[
+    "commonly_precedes",
+    "commonly_follows",
+    "co_occurs_in_trace",
+    "same_component_lifecycle",
+    "potential_rca_context",
+]
+
+
+class Evidence(BaseModel):
+    level: EvidenceLevel = Field(
+        description="Evidence supporting the claim; use unknown when no supplied evidence supports it."
+    )
+    source_ids: list[str] = Field(
+        default_factory=list,
+        description="IDs from supplied documentation or corpus-statistics records.",
+    )
+
+
+class TemplateField(BaseModel):
+    placeholder: str = Field(
+        description="Placeholder position, for example <*>_1 or <*>_2."
+    )
+    semantic_role: str = Field(
+        description="Supported meaning of this placeholder; use unknown when unsupported."
+    )
+    diagnostic_note: str = Field(
+        description="How the value helps correlate events. Do not claim it is anomalous by itself."
+    )
+    evidence: Evidence
+
+
+class TemplateRelation(BaseModel):
+    template_id: str = Field(
+        description="Exact ID from the supplied candidate relations; never invent an ID."
+    )
+    relation: RelationType
+    support: str = Field(
+        description="Brief interpretation of the supplied statistic or documentation."
+    )
+    evidence: Evidence
+
+
+class FailureSignal(BaseModel):
+    name: str = Field(description="Short, evidence-supported failure signal name.")
+    manifestation: str = Field(
+        description="What the target event contributes to observing this signal."
+    )
+    trigger_scope: Literal[
+        "explicit_in_template",
+        "requires_sequence_context",
+        "requires_external_metric",
+    ]
+    evidence: Evidence
+
+
+class EnrichedTemplate(BaseModel):
+    component: str = Field(description="Event-emitting component, or unknown.")
+    component_role: str = Field(description="Supported role of the component, or unknown.")
+    log_level: str = Field(description="Log level present in the template, or unknown.")
+    event_semantics: str = Field(
+        description="Concise factual meaning of this event; do not assert a trace label."
+    )
+    diagnostic_role: DiagnosticRole
+    fields: list[TemplateField] = Field(default_factory=list)
+    sequence_context: list[TemplateRelation] = Field(default_factory=list)
+    failure_signals: list[FailureSignal] = Field(default_factory=list)
+    dataset_label_caveat: str = Field(
+        description="How dataset labels relate to this individual event or template."
+    )
+    embedding_text: str = Field(
+        description="One to three factual sentences for semantic embedding; omit IDs and boilerplate."
+    )
+    unsupported_inferences: list[str] = Field(default_factory=list)
