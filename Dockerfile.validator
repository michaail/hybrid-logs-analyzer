# Isolated Torch HTTP validator. Keep the public API image Torch-free.
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080

WORKDIR /app
COPY requirements-model-validator.txt ./
RUN python -m pip install --upgrade pip && python -m pip install -r requirements-model-validator.txt

COPY src ./src

RUN useradd --create-home --uid 10001 appuser
USER appuser

CMD ["sh", "-c", "python -m src.model_validator.service"]
